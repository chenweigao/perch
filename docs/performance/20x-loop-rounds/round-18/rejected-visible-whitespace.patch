+    /// Equivalent to `s.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty`
+    /// without allocating a trimmed copy: trimmingCharacters returns empty iff
+    /// every Unicode scalar of `s` is a member of the set, and `allSatisfy`
+    /// short-circuits on the first non-whitespace scalar (the common case for
+    /// visible text). Round 18: removes a per-part trimmed String copy from the
+    /// cold projection's hot path. Uses the exact same CharacterSet, so the
+    /// membership semantics (including Unicode whitespace) are byte-identical.
+    private static let whitespaceSet = CharacterSet.whitespacesAndNewlines
+    static func isAllWhitespace(_ s: String) -> Bool {
+        s.unicodeScalars.allSatisfy { whitespaceSet.contains($0) }
+    }
+
