 import Foundation
 
+extension String {
+    /// The same predicate as `!trimmingCharacters(in: .whitespacesAndNewlines).isEmpty`,
+    /// without allocating a trimmed copy. Use Foundation's scalar set, not
+    /// Character.isWhitespace: composed whitespace/mark clusters have different
+    /// semantics. Ordinary prose returns at its first non-whitespace scalar.
+    public var hasNonWhitespaceContent: Bool {
+        let whitespace = CharacterSet.whitespacesAndNewlines
+        return unicodeScalars.contains { !whitespace.contains($0) }
+    }
+}
