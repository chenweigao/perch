+/// Container-only experiment. Uses the exact production rows/measurement/cache.
+/// Does not implement pending prompts, paging, follow-latest or the turn rail.
+struct NativeTranscriptScrollProbe: NSViewRepresentable {
+    let messages: [KimiMessage]
+    let sessionID: String
+    @Environment(\.self) private var environment
+    func makeNSView(context: Context) -> ProbeScroll { ProbeScroll() }
+    func updateNSView(_ scroll: ProbeScroll, context: Context) {
+        scroll.configure(messages, sessionID: sessionID, environment: environment)
+    }
+    static func dismantleNSView(_ scroll: ProbeScroll, coordinator: ()) { scroll.cleanup() }
+
+    final class ProbeScroll: NSScrollView {
+        private let transcript = ConversationDocumentView()
+        private let canvas = ProbeCanvas()
+        private let viewport = ConversationViewport()
+        private let presentation = ConversationPresentationHandle()
+        override init(frame: NSRect) {
+            super.init(frame: frame)
+            drawsBackground = false
+            hasVerticalScroller = false
+            documentView = canvas
+            canvas.addSubview(transcript)
+            viewport.view = self
+            transcript.heightChanged = { [weak self] _ in self?.placeDocument() }
+        }
+        required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+        func configure(_ messages: [KimiMessage], sessionID: String, environment: EnvironmentValues) {
+            let snapshot = presentation.update(key: sessionID, input: .init(messages: messages, language: environment.locale.identifier + ":" + AppLanguage.current.localization), cache: nil)
+            let rows = snapshot.displayedRows { _ in nil }.map {
+                ConversationEntryView(entry: $0.entry, tools: $0.tools, api: nil, sessionId: sessionID,
+                                      memoryKey: sessionID + ":" + $0.entry.id, activityNarrative: $0.activity)
+            }
+            transcript.configure(rows, contentIdentity: .init(snapshot: snapshot, narratives: [:], api: nil,
+                                 session: sessionID, memoryKey: sessionID), navigation: snapshot.navigation,
+                                 sessionId: sessionID, appearance: ConversationEntryAppearance(environment),
+                                 viewport: viewport, contentOriginY: 12)
+            placeDocument()
+        }
+        override func layout() { super.layout(); placeDocument() }
+        private func placeDocument() {
+            let width = min(ReplyStyle.readingWidth, max(1, contentView.bounds.width - 72))
+            let size = transcript.measure(width: width)
+            let frame = CGRect(x: (contentView.bounds.width - width) / 2, y: 12, width: width, height: size.height)
+            if transcript.frame != frame { transcript.frame = frame }
+            let canvasSize = CGSize(width: contentView.bounds.width, height: size.height + 43)
+            if canvas.frame.size != canvasSize { canvas.setFrameSize(canvasSize) }
+            reflectScrolledClipView(contentView)
+        }
+        func cleanup() { transcript.prepareForRemoval() }
+    }
+    private final class ProbeCanvas: NSView { override var isFlipped: Bool { true } }
+}
+#endif
 
