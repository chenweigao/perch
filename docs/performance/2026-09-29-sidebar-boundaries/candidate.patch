-/// The enclosing sidebar already observes the workspace model. An `@ObservedObject`
-/// here would register one observer per visible row, so a single search keystroke or
-/// streamed catalog update invalidates every row body instead of just the list.
-private struct SessionSidebarRow: View {
-    @UILocalization private var L
+/// Catalog values enter through the parent; selection and operational state are
+/// read here. Equal catalog inputs do not rebuild every row's observation scope.
+private struct SidebarSessionLink: View, Equatable {
+    let model: WorkbenchModel
+    let item: WorkspaceSession
+    let groups: [String]
+    static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.model === rhs.model && lhs.item == rhs.item && lhs.groups == rhs.groups
+    }
+    var body: some View {
+        SidebarSessionContent(model: model, presentation: SessionSidebarRowPresentation(
+            model: model, item: item, groups: groups,
+            selected: !model.showDashboard && item.id == model.tabs.selectedID)).equatable()
+    }
+}
+
+/// Compare complete rendered inputs, not action closures. Actions are constructed
+/// inside this boundary from the same model and item, so they cannot become stale.
+private struct SidebarSessionContent: View, Equatable {
     let model: WorkbenchModel
+    let presentation: SessionSidebarRowPresentation
+    static func == (lhs: Self, rhs: Self) -> Bool {
+        lhs.model === rhs.model && lhs.presentation == rhs.presentation
+    }
+    var body: some View {
+        SessionSidebarRow(model: model, presentation: presentation,
+                          onOpen: { model.open(presentation.item) })
+    }
+}
+
