#!/bin/bash
# Round 36 v1 Mac mini formal A/B (ARBITRATION side, decides adoption):
# joined foldParents COW adoption along the prepend alignment. base =
# fd79884 (merged round-35; product tree includes round-35 incremental
# indexes; equal 4-decimal reopen print on BOTH sides — no fixture patch).
# candidate = c987ff9c (round-36 v1). Adoption rides on
# older_page_full_chain (expected -8~12% from the joined hash/merge
# elimination; Linux sentinel showed -17~-22%) with presentation/chain/
# find metrics as guards. BOTH sides are pristine checkouts — no patch
# application, no dirty-tree abort mode (r31b lesson); every exit code is
# recorded without pipe-swallowing (r31d lesson). Six alternating pairs x
# five modes, binaries IN PLACE (round-18).
set -u
cd "$HOME/_worktrees/20x-loop-20261112/perch"
LOGS="$HOME/Library/Logs/perf-loop-20261116"
RES="$LOGS/ab36v1"
rm -rf "$RES"; mkdir -p "$RES"
echo "=== prepare $(date) ==="
git fetch origin
git checkout -- . 2>/dev/null; git clean -fdq Sources/ Tests/
echo "porcelain_preclean=$(git status --porcelain | wc -l | tr -d ' ')"
git checkout --detach fd79884
echo "HEAD_base=$(git rev-parse HEAD)"
rm -rf .build/round36v1-ab-base .build/round36v1-ab-cand
echo "=== base build (pristine 529d41e) $(date) ==="
swift build -c release --product WorkbenchChecks --scratch-path .build/round36v1-ab-base > "$RES/base-build.log" 2>&1
base_build_exit=$?; echo "base_build_exit=$base_build_exit"
shasum -a 256 Tests/WorkbenchCoreTests/PresentationBench.swift Tests/WorkbenchCoreTests/StreamingBench.swift Tests/WorkbenchCoreTests/ActivityBench.swift Tests/WorkbenchCoreTests/EditLineBench.swift Tests/WorkbenchCoreTests/BenchClock.swift Tests/WorkbenchCoreTests/LinkScanMaterializeTests.swift > "$RES/fixture-hashes-base.txt"
echo "=== candidate checkout + build (740b5f2e) $(date) ==="
git checkout --detach c987ff9c
echo "HEAD_cand=$(git rev-parse HEAD)"
swift build -c release --product WorkbenchChecks --scratch-path .build/round36v1-ab-cand > "$RES/cand-build.log" 2>&1
cand_build_exit=$?; echo "cand_build_exit=$cand_build_exit"
shasum -a 256 Tests/WorkbenchCoreTests/PresentationBench.swift Tests/WorkbenchCoreTests/StreamingBench.swift Tests/WorkbenchCoreTests/ActivityBench.swift Tests/WorkbenchCoreTests/EditLineBench.swift Tests/WorkbenchCoreTests/BenchClock.swift Tests/WorkbenchCoreTests/LinkScanMaterializeTests.swift > "$RES/fixture-hashes-cand.txt"
if [ "$base_build_exit" != 0 ] || [ "$cand_build_exit" != 0 ]; then
  echo ABORT_BUILD
  git checkout -- . 2>/dev/null; git clean -fdq Sources/ Tests/
  rm -rf .build/round36v1-ab-base .build/round36v1-ab-cand
  echo "porcelain_after=$(git status --porcelain | wc -l | tr -d ' ')"
  echo "DONE $(date)"
  exit 1
fi
BASE="$PWD/.build/round36v1-ab-base/out/Products/Release/WorkbenchChecks"
CAND="$PWD/.build/round36v1-ab-cand/out/Products/Release/WorkbenchChecks"
shasum -a 256 "$BASE" "$CAND" | tee "$RES/binary-hashes.txt"
echo "=== checks both sides (base = round-30 pin set, record; cand = gate) $(date) ==="
"$BASE" > "$RES/checks-base.log" 2>&1; base_checks_exit=$?
echo "base_checks_exit=$base_checks_exit pass=$(grep -c '^PASS' "$RES/checks-base.log")"
"$CAND" > "$RES/checks-cand.log" 2>&1; cand_checks_exit=$?
echo "cand_checks_exit=$cand_checks_exit pass=$(grep -c '^PASS' "$RES/checks-cand.log")"
grep -h 'prefix cache' "$RES/checks-cand.log"
if [ "$base_checks_exit" != 0 ] || [ "$cand_checks_exit" != 0 ]; then
  echo ABORT_CHECKS
  git checkout -- . 2>/dev/null; git clean -fdq Sources/ Tests/
  rm -rf .build/round36v1-ab-base .build/round36v1-ab-cand
  echo "porcelain_after=$(git status --porcelain | wc -l | tr -d ' ')"
  echo "DONE $(date)"
  exit 1
fi
echo "=== pairs $(date) ==="
for pair in 1 2 3 4 5 6; do
  for variant in baseline candidate; do
    bin="$BASE"
    [ "$variant" = candidate ] && bin="$CAND"
    for mode in 1 streaming activity edit-lines presentation-token; do
      WORKBENCH_BENCH="$mode" "$bin" > "$RES/pair$pair-$variant-$mode.log" 2>&1
      echo "pair=$pair variant=$variant mode=$mode exit=$?"
    done
  done
done
shasum -a 256 "$BASE" "$CAND" | tee "$RES/binary-hashes-final.txt"
git checkout -- . 2>/dev/null; git clean -fdq Sources/ Tests/
rm -rf .build/round36v1-ab-base .build/round36v1-ab-cand
echo "porcelain_after=$(git status --porcelain | wc -l | tr -d ' ')"
echo "DONE $(date)"
