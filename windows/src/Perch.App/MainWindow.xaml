<Window x:Class="Perch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Perch.App"
        Title="Perch — Windows 远程会话"
        Height="720" Width="1120"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Segoe UI Emoji"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- One chat row. The bubble aligns right for the user, left otherwise, using
             style triggers rather than a converter so the row stays declarative. -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type local:MessageRow}">
            <Grid Margin="0,4">
                <Border CornerRadius="8" Padding="12,8" MaxWidth="640">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{StaticResource AssistantBubbleBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSystemNote}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Header}"
                                   Visibility="{Binding HeaderVisibility}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding Text}"
                                   Visibility="{Binding TextVisibility}"
                                   TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="InteractionTemplate" DataType="{x:Type local:InteractionRow}">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0"
                               FontFamily="Consolas, Cascadia Mono, Segoe UI"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="待审批：本客户端只显示状态，不自动批准。请在会话终端处理。"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionRow}">
            <StackPanel Margin="4,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Connect panel -->
        <Grid Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="连接到远端 Perch Agent 桥接" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"
                           Text="输入已有的 SSH 配置别名和远端 bridge 的 loopback 端口。Perch 使用系统 OpenSSH、你已有的 config/key/agent 建立仅本机 loopback 的转发；严格校验主机密钥，不会自动接受未知主机、不保存密码、不终止远端 agent，也不会隐式接管会话。"/>

                <TextBlock Text="SSH 别名或 user@host" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="远端桥接 loopback 端口" Margin="0,0,0,4"/>
                <TextBox Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="访问令牌" Margin="0,0,0,6"/>
                <RadioButton Content="安全输入（仅本次连接，留在内存）" IsChecked="{Binding UseSecureInput}"
                             GroupName="token" Margin="0,0,0,6" Foreground="{StaticResource ForegroundBrush}"/>
                <PasswordBox x:Name="TokenBox" Margin="0,0,0,10" PasswordChanged="TokenBox_PasswordChanged"
                             Visibility="{Binding UseSecureInput, Converter={StaticResource BoolToVisibility}}"/>
                <RadioButton x:Name="TokenFileRadio" Content="从受限权限文件加载" GroupName="token" Margin="0,0,0,6"
                             Checked="TokenFileRadio_Checked" Foreground="{StaticResource ForegroundBrush}"/>
                <Grid Visibility="{Binding UseSecureInput, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TokenFilePath}" IsReadOnly="True" Margin="0,0,8,10"/>
                    <Button Grid.Column="1" Content="浏览…" Click="BrowseToken_Click" Margin="0,0,0,10"/>
                </Grid>

                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="令牌只在内存使用，不写日志或明文配置。令牌文件若对其他本地用户可读，将被拒绝读取。"/>

                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="连接" IsEnabled="{Binding CanConnect}" Click="Connect_Click" MinWidth="96"
                            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main panel -->
        <Grid Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="12">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                         ItemTemplate="{StaticResource SessionTemplate}" Margin="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12">
                    <Button Content="断开" Click="Disconnect_Click"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap" Width="150" Text="只释放本客户端与本地 SSH 进程"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"/>
                </ScrollViewer>

                <Border Grid.Row="1" Padding="12,4"
                        Visibility="{Binding HasInteractions, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Interactions}" ItemTemplate="{StaticResource InteractionTemplate}"/>
                </Border>

                <Grid Grid.Row="2" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" KeyDown="Composer_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Enter 发送，Shift+Enter 换行；中文、emoji、引号与路径原样发送。"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消回合" IsEnabled="{Binding CanCancel}" Click="Cancel_Click"/>
                        <Button Content="发送" IsEnabled="{Binding CanSend}" Click="Send_Click" MinWidth="80"
                                Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
