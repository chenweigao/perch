<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.agentworkbench.mac</string>
<key>CFBundleName</key><string>Perch</string>
<key>CFBundleDisplayName</key><string>Perch</string>
<key>CFBundleIconFile</key><string>Perch</string>
<key>CFBundleExecutable</key><string>AgentWorkbench</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleDevelopmentRegion</key><string>zh-Hans</string>
<key>CFBundleLocalizations</key><array><string>zh-Hans</string><string>en</string></array>
<key>CFBundleAllowMixedLocalizations</key><true/>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>NSPrincipalClass</key><string>NSApplication</string>
<key>NSAppleEventsUsageDescription</key><string>Perch opens Terminal so you can complete SSH login and remote agent setup.</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSLocalNetworkUsageDescription</key><string>Perch connects to the activity summary service you configure on your local network.</string>
<key>NSAppTransportSecurity</key><dict>
    <key>NSAllowsLocalNetworking</key><true/>
    <!-- macOS 14+ requires explicit exceptions for HTTP IP literals. Summary
         endpoints are user-configured, so allow IPv4/IPv6 literals without
         embedding a deployment address or disabling ATS for DNS domains. -->
    <key>NSExceptionDomains</key><dict>
        <key>0.0.0.0/0</key><dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        </dict>
        <key>::/0</key><dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key><true/>
        </dict>
    </dict>
</dict>
<key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
</dict></plist>
