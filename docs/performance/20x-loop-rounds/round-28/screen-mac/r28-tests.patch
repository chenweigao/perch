--- /dev/null
+++ b/Tests/WorkbenchCoreTests/SwarUTF16CountTests.swift
@@ -0,0 +1,117 @@
+import Foundation
+import WorkbenchCore
+
+/// Pins the round-28 screening candidate `utf16CountViaUTF8` (SWAR UTF-16 unit
+/// count over UTF-8 bytes) byte-exact against the stdlib `utf16.count` it
+/// replaces at ConversationActivity's progress/outputCharacters sites:
+/// exhaustive single-scalar sweep (every non-surrogate scalar, both ASCII and
+/// non-ASCII, embedded in a carrier so word/tail paths both see it), structural
+/// word-boundary cases, and seeded fuzz over mixed scripts, emoji sequences,
+/// ZWJ, combining marks and flags. A Unicode data update cannot change this
+/// identity (it is a UTF-8 encoding-form property), but any implementation
+/// slip in the SWAR masks fails loudly here.
+func checkSwarUTF16Count() throws {
+    // The extension is internal; exercise it through a mirror of the exact
+    // product implementation compiled into the test target would duplicate
+    // code — instead the sweep runs through ConversationActivity's observable
+    // contract below AND through the @testable-free public surface: the pin
+    // replicates the algorithm verbatim and asserts the replication equals
+    // utf16.count exhaustively; the product sites are separately pinned by the
+    // activity contract checks (progressSignature/outputCharacters equality
+    // against pre-change values is asserted in checkActivitySummaries).
+    func swar(_ text: String) -> Int {
+        var contiguous = text
+        return contiguous.withUTF8 { bytes -> Int in
+            let n = bytes.count
+            guard let base = bytes.baseAddress else { return 0 }
+            let p = UnsafeRawPointer(base)
+            var leads = 0, fourByte = 0, i = 0
+            let m7 = 0x7F7F7F7F7F7F7F7F as UInt64
+            while i + 8 <= n {
+                let word = p.loadUnaligned(fromByteOffset: i, as: UInt64.self)
+                let masked = (word & 0xC0C0C0C0C0C0C0C0) ^ 0x8080808080808080
+                let contMarks = ~(((masked & m7) &+ m7) | masked | m7)
+                let hi = (word & 0xF0F0F0F0F0F0F0F0) ^ 0xF0F0F0F0F0F0F0F0
+                let fMarks = ~(((hi & m7) &+ m7) | hi | m7)
+                leads += 8 - contMarks.nonzeroBitCount
+                fourByte += fMarks.nonzeroBitCount
+                i += 8
+            }
+            while i < n {
+                let b = bytes[i]
+                if b & 0xC0 != 0x80 { leads += 1 }
+                if b >= 0xF0 { fourByte += 1 }
+                i += 1
+            }
+            return leads + fourByte
+        }
+    }
+
+    // Product-surface pin FIRST: ConversationActivity.outputCharacters is
+    // computed through the routed SWAR sites; the oracle here is the stdlib
+    // utf16.count summed by the test itself over the same fixture parts. Any
+    // divergence between the product path and the stdlib identity fails here.
+    let tricky: [String] = [
+        "结论：café 已完成。", String(repeating: "中", count: 33), "plain ascii tail",
+        "👩🏽‍💻🇨🇳𝄞e\u{301}", String(repeating: "a", count: 7) + "中" + String(repeating: "b", count: 8) + "🏽",
+    ]
+    let wire: [[String: Any]] = [
+        ["id": "u0", "role": "user", "created_at": "000001",
+         "content": [["type": "text", "text": "开始"]]],
+        ["id": "a0", "role": "assistant", "created_at": "000002",
+         "content": [["type": "thinking", "thinking": tricky[0]],
+                     ["type": "text", "text": tricky[1]]]],
+        ["id": "a1", "role": "assistant", "created_at": "000003",
+         "content": [["type": "text", "text": tricky[2]],
+                     ["type": "thinking", "thinking": tricky[3]],
+                     ["type": "text", "text": tricky[4]]]],
+    ]
+    let messages = try KimiWire.decoder().decode([KimiMessage].self,
+                                                 from: JSONSerialization.data(withJSONObject: wire))
+    let activity = ConversationActivity(messages: messages, isRunning: false)
+    let oracle = tricky.reduce(0) { $0 + $1.utf16.count }
+    precondition(activity.outputCharacters == oracle,
+                 "product outputCharacters \(activity.outputCharacters) != stdlib oracle \(oracle)")
+
+    // exhaustive single-scalar sweep, bare and in a 7-ASCII carrier so the
+    // scalar lands in every word/tail alignment (0..7 mod 8)
+    var swept = 0
+    for value in 0...0x10FFFF {
+        guard !(0xD800...0xDFFF).contains(value), let scalar = Unicode.Scalar(value) else { continue }
+        let s = String(scalar)
+        precondition(s.utf16.count == swar(s), "scalar \(String(value, radix: 16)) bare")
+        for pad in 0...7 {
+            let carrier = String(repeating: "x", count: pad) + s + "y"
+            precondition(carrier.utf16.count == swar(carrier),
+                         "scalar \(String(value, radix: 16)) pad \(pad)")
+        }
+        swept += 1
+    }
+
+    // structural: empty, ASCII lengths around word boundaries, mixed
+    let structural: [String] = [
+        "", "x", "xy", "中文", "中文中文中", "中文中文中文", "中文中文中文中",
+        String(repeating: "a", count: 7) + "中",
+        String(repeating: "a", count: 8) + "中",
+        String(repeating: "中", count: 1000),
+        "a👩🏽‍👩🏽b", "🇨🇳🇨🇳🇨🇳", "e\u{301}e\u{301}e\u{301}", "𝄞𝄞𝄞",
+    ]
+    for s in structural {
+        precondition(s.utf16.count == swar(s), "structural \(s.debugDescription)")
+    }
+
+    // seeded fuzz over mixed pieces
+    var state: UInt64 = 0x2026_1116_0028
+    func next() -> UInt64 { state = state &* 6364136223846793005 &+ 1442695040888963407; return state >> 11 }
+    let pieces = ["a", "检", "中文", "👩", "🏽", "é", "e\u{301}", " ", "\n", "🇨🇳", "\u{200D}", "x", "𝄞", "한",
+                  String(repeating: "z", count: 9), "👩🏽‍💻"]
+    var fuzzed = 0
+    for _ in 0..<20000 {
+        var s = ""
+        for _ in 0..<(next() % 20) { s += pieces[Int(next() % UInt64(pieces.count))] }
+        precondition(s.utf16.count == swar(s), "fuzz \(s.debugDescription)")
+        fuzzed += 1
+    }
+
+    print("PASS: SWAR utf16 count — product surface (ConversationActivity.outputCharacters == stdlib oracle on tricky corpus), exhaustive scalar sweep (\(swept) scalars × 9 alignments) + \(structural.count) structural + \(fuzzed) seeded fuzz strings all byte-exact vs stdlib utf16.count")
+}
